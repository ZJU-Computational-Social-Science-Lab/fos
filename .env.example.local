# FOS — Local development configuration
# Copy this file to .env before running locally.

# Debug mode
FOS_DEBUG=false

# Backend listen and routing
FOS_BACKEND_HOST=0.0.0.0
FOS_BACKEND_PORT=8000
FOS_BACKEND_ROOT_PATH=/
FOS_APP_BASE_URL=http://0.0.0.0:8090
FOS_SIMTREE_IDLE_TTL_SECONDS=3600
FOS_SIMTREE_CLEANUP_INTERVAL_SECONDS=300
LLM_MAX_CONCURRENT_PER_CLIENT=2
FOS_LLM_CONCURRENCY=2
OLLAMA_NUM_PARALLEL=2

# Database — SQLite for local development
FOS_DATABASE_URL=sqlite+aiosqlite:///./fos.db

# JWT signing key — MUST be changed for production
FOS_JWT_SIGNING_KEY=change-me-to-a-random-secret

# Admin account initialisation
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=
ADMIN_ORGANIZATION=

# Optional: allowed CORS origins
FOS_ALLOWED_ORIGINS=[]

# Optional: email verification
FOS_REQUIRE_EMAIL_VERIFICATION=false

# GAWorld path — required for gaworld scene simulations
# Expected layout: GAWorld repo lives alongside the FOS repo (../GAWorld)
# Override if your GAWorld checkout is elsewhere.
GAWORLD_PATH=../GAWorld

# Video: Bilibili external player (optional)
# Get BV ID from your Bilibili video URL: https://www.bilibili.com/video/BVxxxxxxxxx
VITE_BILIBILI_VIDEO_BVID=
